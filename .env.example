# ==========================================================================
# MEDMOST - Environment Variables for Supabase Connection
# In Vercel: Project Settings > Environment Variables > Add these two keys:
# ==========================================================================

# 1. Supabase Project URL
# IMPORTANT: Must end in .supabase.co
# DO NOT append /rest/v1 or trailing slashes!
# Correct:   https://cyycbbzscvdojmdelutm.supabase.co
# Incorrect: https://cyycbbzscvdojmdelutm.supabase.co/rest/v1
SUPABASE_URL=https://cyycbbzscvdojmdelutm.supabase.co

# 2. Supabase Anon / Public API Key
# Copy this from your Supabase Dashboard: Settings > API > Project API Keys > anon / public
SUPABASE_ANON_KEY=your-supabase-anon-key-here

